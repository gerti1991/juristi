# Albanian Legal RAG System - Environment Variables
# Copy this file to .env and add your actual API keys

# Embedding Model Configuration
# Options: "google", "sentence-transformers", "bge"
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Google AI Configuration (Get API key from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_EMBEDDING_MODEL=models/embedding-001

# BGE Embedding Models (Free, local processing)
# For Albanian legal text processing
BGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DEVICE=auto

# Groq API Configuration (Backup)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Search Configuration  
SIMILARITY_THRESHOLD=0.15
MAX_CONTEXT_LENGTH=4000
MAX_CHUNKS_TO_RETURN=5

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
BATCH_SIZE=50

# System Configuration
VERBOSE=true
UI_ONLY=false

# UI Configuration
APP_TITLE=⚖️ Juristi AI - Albanian Legal Assistant
APP_DESCRIPTION=Advanced AI-Powered Legal Research System for Albanian Law
