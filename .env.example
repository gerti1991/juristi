# Albanian Legal RAG System - Environment Configuration
# Copy this file to .env and add your actual values

# REQUIRED: Google AI Configuration
# Get API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# OPTIONAL: Telegram Bot Integration
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_BOT_USERNAME=your_bot_username

# OPTIONAL: System Configuration
RAG_MODEL_NAME=gemini-1.5-flash
EMBEDDING_MODEL_NAME=models/text-embedding-004
CHROMA_PERSIST_DIRECTORY=./chroma_db
LOG_LEVEL=INFO

# OPTIONAL: Advanced Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_RETRIEVAL_DOCUMENTS=15
TEMPERATURE=0.1
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Search Configuration  
SIMILARITY_THRESHOLD=0.15
MAX_CONTEXT_LENGTH=4000
MAX_CHUNKS_TO_RETURN=5

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
BATCH_SIZE=50

# System Configuration
VERBOSE=true
UI_ONLY=false

# UI Configuration
APP_TITLE=⚖️ Juristi AI - Albanian Legal Assistant
APP_DESCRIPTION=Advanced AI-Powered Legal Research System for Albanian Law
